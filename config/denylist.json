  "tier_3_patterns": [
    {
      "id": "property_of",
      "regex": "\\bproperty of\\s+\\w+",
      "reason": "Mimics licensed collegiate and team merchandise conventions."
    },
    {
      "id": "athletic_dept",
      "regex": "\\b(athletic|athletics)\\s+(dept|department)\\b",
      "reason": "Collegiate licensing lockup."
    },
    {
      "id": "est_year_collegiate",
      "regex": "\\best\\.?\\s*(18|19|20)\\d{2}\\b",
      "reason": "Institutional founding-date format used on licensed goods. Often benign -- human decides."
    },
    {
      "id": "university_of",
      "regex": "\\buniversity of\\s+\\w+",
      "reason": "Named institutions license their marks."
    },
    {
      "id": "official_licensed",
      "regex": "\\b(official|officially licensed|authentic)\\b.*\\b(merch|merchandise|product|gear)\\b",
      "reason": "Claims a licensing relationship that does not exist."
    },
    {
      "id": "trademark_symbols",
      "regex": "[\\u00ae\\u2122\\u00a9]",
      "reason": "Registered/trademark/copyright symbols in listing text."
    },
    {
      "id": "team_city_sport",
      "regex": "\\b\\w+\\s+(football|basketball|baseball|hockey)\\s+(club|team)\\b",
      "reason": "City-plus-sport constructions frequently name a real franchise."
    }
  ]
